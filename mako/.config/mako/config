# --- Mako Professional Configuration ---

# Global Settings
max-history=100
sort=-time

# Appearance
font=JetBrainsMono Nerd Font 10
width=350
height=150
margin=15
padding=15
border-size=2
border-radius=10
icons=1
max-icon-size=48

# Positioning (Top Right is standard for Pro workstations)
anchor=top-right

# Colors (Catppuccin Mocha Palette)
background-color=#1e1e2ee6
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #313244

# THE KEY: Auto-dismiss after 8 seconds
default-timeout=5000

# Transparency/Blur (Handled by Hyprland Layer Rules)
# This background alpha 'e6' is roughly 90% opaque.

[urgency=low]
border-color=#a6adc8
default-timeout=5000

[urgency=high]
border-color=#f38ba8
default-timeout=0
# High urgency (like system errors) stays until clicked
